{
  "id": "/app/",
  "name": "Finanzas personales",
  "short_name": "Finanzas",
  "description": "Tus cuentas del mes, al día y sin anotar nada a mano.",
  "lang": "es-CO",
  "dir": "ltr",
  "start_url": "/app/",
  "scope": "/app/",
  "display": "standalone",
  "orientation": "any",
  "theme_color": "#E6DAC0",
  "background_color": "#E6DAC0",
  "icons": [
    {
      "src": "/app/iconos/icono-192.png",
      "sizes": "192x192",
      "type": "image/png",
      "purpose": "any"
    },
    {
      "src": "/app/iconos/icono-512.png",
      "sizes": "512x512",
      "type": "image/png",
      "purpose": "any"
    },
    {
      "src": "/app/iconos/icono-maskable-512.png",
      "sizes": "512x512",
      "type": "image/png",
      "purpose": "maskable"
    }
  ],
  "share_target": {
    "action": "/app/compartir",
    "method": "POST",
    "enctype": "multipart/form-data",
    "params": {
      "files": [
        {
          "name": "archivo",
          "accept": [
            ".xlsx",
            "application/vnd.openxmlformats-officedocument.spreadsheetml.sheet"
          ]
        }
      ]
    }
  }
}
