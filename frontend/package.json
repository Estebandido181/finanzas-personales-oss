{
  "name": "finanzas-frontend",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "description": "Frontend de la v2 (ítem 12): React + TypeScript + Vite + Tailwind + shadcn/ui, servido en /app.",
  "engines": {
    "node": ">=24 <25"
  },
  "scripts": {
    "tipos": "openapi-typescript ../openapi/openapi.json -o src/api/esquema.d.ts",
    "dev": "vite",
    "build": "tsc -p tsconfig.json && vite build",
    "test": "vitest run",
    "e2e": "playwright test --project=pruebas",
    "capturas": "playwright test --project=capturas"
  },
  "dependencies": {
    "@radix-ui/react-slot": "1.3.3",
    "class-variance-authority": "0.7.1",
    "clsx": "2.1.1",
    "lucide-react": "1.49.0",
    "openapi-fetch": "0.17.0",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "tailwind-merge": "3.7.0",
    "wouter": "3.12.0"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.13.0",
    "@playwright/test": "1.63.0",
    "@tailwindcss/vite": "4.3.3",
    "@testing-library/jest-dom": "7.0.1",
    "@testing-library/react": "16.3.3",
    "@testing-library/user-event": "14.6.7",
    "@types/node": "24.19.0",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.1.1",
    "jsdom": "30.1.1",
    "openapi-typescript": "7.13.0",
    "tailwindcss": "4.3.3",
    "typescript": "5.9.3",
    "vite": "8.3.1",
    "vitest": "5.0.3"
  }
}
