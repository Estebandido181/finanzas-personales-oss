# Copia este archivo a .env y reemplaza los valores. Nunca subas .env al repositorio.

# Ruta del archivo SQLite.
DB_PATH=finanzas.db

# Hash de la contraseña de la app. Genéralo con: python -m finanzas.seguridad
# Formato: scrypt:16384:8:1:<sal_hex>:<hash_hex> (una sola línea, sin comillas).
# Si no tiene ese formato, la app no arranca.
APP_PASSWORD_HASH=reemplazar-con-salida-de-python-m-finanzas.seguridad

# Clave para firmar la cookie de sesión (mínimo 32 caracteres, aleatoria).
# Genérala con: python -c "import secrets; print(secrets.token_urlsafe(48))"
SESSION_SECRET=

# true en producción (solo HTTPS). false únicamente para probar en local por HTTP.
COOKIE_SECURE=true

# Intentos fallidos de login permitidos antes de bloquear la IP, y minutos de bloqueo.
MAX_INTENTOS=5
BLOQUEO_MINUTOS=15

# Gmail (opcional: sin esto la app arranca, pero "Sincronizar" da un error claro).
# Ruta ABSOLUTA del token generado con "python -m finanzas.gmail autorizar"
# (ver "Conectar Gmail" en el README). El archivo debe tener permisos 600.
GMAIL_TOKEN=
# Desde el ítem 27 (D30) la app lee siempre los dos remitentes oficiales de
# Bancolombia y no se configuran. GMAIL_REMITENTE ya no se usa: si aún la
# tienes, déjala vacía o bórrala (con otra dirección la app no arranca).
